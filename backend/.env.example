PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bloodconnect
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
# Comma-separated origins, or * for dev defaults (localhost + 127.0.0.1 on common Expo ports)
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081
NODE_ENV=development
CLIENT_URL=http://localhost:8081
EMAIL_USER=example@email.com
EMAIL_PASS=your_email_password
